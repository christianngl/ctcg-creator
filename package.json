{
  "name": "ctcg-creator",
  "version": "0.5.0",
  "private": true,
  "description": "Custom TCG Creator – Desktop-App zum Gestalten, Drucken und Verwalten eigener Sammel- und Spielkartensets",
  "main": "src/app/main.js",
  "bin": {
    "ctcg-creator": "src/cli/index.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "predist": "node tools/dist-vorbereiten.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
  "author": "Christian Nagel",
  "build": {
    "appId": "de.wildhunt.cardcreator",
    "productName": "cTCG Creator",
    "copyright": "© 2026 Christian Nagel",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md"
    ],
    "asarUnpack": [
      "src/vorlagen/**",
      "node_modules/@fontsource-variable/inter/files/**"
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "cTCG Creator",
      "artifactName": "cTCG-Creator-Setup-${version}.exe",
      "include": "infra/installer.nsh",
      "packElevateHelper": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "cTCG-Creator-${version}-portable.exe"
    }
  }
}
